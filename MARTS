//| CLASS 7: NEWS GUARD - High Impact Events                         |
//+------------------------------------------------------------------+
class CNewsGuard
{
public:
   bool IsSafeToTrade()
   {
      if(!EnableNewsFilter) return true;
      
      MqlCalendarValue values[];
      MqlCalendarEvent event;
      datetime now = TimeCurrent();
      datetime from = now - (NewsBufferMinutes * 60);
      datetime to = now + (NewsBufferMinutes * 60);
      
      if(CalendarValueGet(values, from, to))
      {
         for(int i = 0; i < ArraySize(values); i++)
         {
            if(CalendarEventById(values[i].event_id, event))
            {
               if(event.importance == CALENDAR_IMPORTANCE_HIGH)
               {
                  return false;
               }
            }
         }
      }
      return true;
   }
   
   string GetNextNews()
   {
      MqlCalendarValue values[];
      MqlCalendarEvent event;
      datetime now = TimeCurrent();
      
      if(CalendarValueGet(values, now, now + 86400))
      {
         for(int i = 0; i < ArraySize(values); i++)
         {
            if(CalendarEventById(values[i].event_id, event))
            {
               if(event.importance == CALENDAR_IMPORTANCE_HIGH)
               {
                  return StringFormat("%s at %s", event.name, TimeToString(values[i].time));
               }
            }
         }
      }
      return "None";
   }
};

