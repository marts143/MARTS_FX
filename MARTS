//| CLASS 5: VOLUME PROFILE ANALYZER                                 |
//+------------------------------------------------------------------+
class CVolumeProfileAnalyzer
{
private:
   string m_symbol;
   
public:
   CVolumeProfileAnalyzer(string symbol) { m_symbol = symbol; }
   
   SVolumeProfile CalculateProfile(int lookback = 100)
   {
      SVolumeProfile result;
      
      double highs[];
      double lows[];
      long volumes[];
      
      ArraySetAsSeries(highs, true);
      ArraySetAsSeries(lows, true);
      ArraySetAsSeries(volumes, true);
      
      CopyHigh(m_symbol, PERIOD_H1, 0, lookback, highs);
      CopyLow(m_symbol, PERIOD_H1, 0, lookback, lows);
      CopyTickVolume(m_symbol, PERIOD_H1, 0, lookback, volumes);
      
      double maxPrice = highs[ArrayMaximum(highs, 0, lookback)];
      double minPrice = lows[ArrayMinimum(lows, 0, lookback)];
      double range = maxPrice - minPrice;
      int bins = 50;
      double binSize = range / bins;
      
      double volumeByBin[];
      ArrayResize(volumeByBin, bins);
      ArrayInitialize(volumeByBin, 0);
      
      for(int i = 0; i < lookback; i++)
      {
         int bin = (int)((highs[i] - minPrice) / binSize);
         if(bin >= 0 && bin < bins)
            volumeByBin[bin] += volumes[i];
      }
      
      // Find Point of Control
      int pocBin = 0;
      double maxVolume = 0;
      for(int i = 0; i < bins; i++)
      {
         if(volumeByBin[i] > maxVolume)
         {
            maxVolume = volumeByBin[i];
            pocBin = i;
         }
      }
      
      result.poc = minPrice + (pocBin + 0.5) * binSize;
      
      // VWAP
      double totalValue = 0;
      double totalVolume = 0;
      for(int i = 0; i < lookback; i++)
      {
         double avgPrice = (highs[i] + lows[i]) / 2;
         totalValue += avgPrice * volumes[i];
         totalVolume += volumes[i];
      }
      result.vwap = (totalVolume > 0) ? totalValue / totalVolume : 0;
      
      return result;
   }
};

