//| CLASS 1: GROWTH SCALER - From $5 to $100,000                     |
//+------------------------------------------------------------------+
class CGrowthScaler
{
private:
   double m_initialEquity;
   double m_peakEquity;
   double m_lockedEquity;
   ENUM_GROWTH_PHASE m_currentPhase;
   
public:
   CGrowthScaler(double initial)
   {
      m_initialEquity = initial;
      m_peakEquity = initial;
      m_lockedEquity = initial;
      m_currentPhase = PHASE_SURVIVAL;
   }
   
   struct SScalingResult
   {
      double lotSize;
      ENUM_GROWTH_PHASE phase;
      string phaseName;
      double riskPercent;
      double riskAmount;
      bool useReversalOnly;
      double lockedEquity;
   };
   
   SScalingResult Calculate(double stopLossPoints)
   {
      SScalingResult result;
      double equity = AccountInfoDouble(ACCOUNT_EQUITY);
      
      // Update peak equity
      if(equity > m_peakEquity)
      {
         m_peakEquity = equity;
         CheckMilestone();
      }
      
      // Determine phase based on current equity
      DeterminePhase(equity);
      result.phase = m_currentPhase;
      result.lockedEquity = m_lockedEquity;
      
      // Set phase-specific parameters
      switch(m_currentPhase)
      {
         case PHASE_SURVIVAL:
            result.phaseName = "SURVIVAL";
            result.riskPercent = Risk_Phase1;
            result.useReversalOnly = ReversalOnlySmall;
            break;
         case PHASE_SCALING:
            result.phaseName = "SCALING";
            result.riskPercent = Risk_Phase2;
            result.useReversalOnly = false;
            break;
         case PHASE_GROWTH:
            result.phaseName = "GROWTH";
            result.riskPercent = Risk_Phase3;
            result.useReversalOnly = false;
            break;
         default:
            result.phaseName = "INSTITUTIONAL";
            result.riskPercent = Risk_Phase4;
            result.useReversalOnly = false;
      }
      
      result.riskAmount = equity * (result.riskPercent / 100.0);
      
      // Calculate lot size
      if(stopLossPoints > 0 && result.riskAmount > 0)
      {
         double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
         double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
         double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
         
         result.lotSize = result.riskAmount / (stopLossPoints * tickValue);
         result.lotSize = MathFloor(result.lotSize / lotStep) * lotStep;
         result.lotSize = MathMax(result.lotSize, minLot);
         
         // Ultra-conservative for survival phase
         if(m_currentPhase == PHASE_SURVIVAL)
            result.lotSize = MathMin(result.lotSize, minLot);
      }
      else
      {
         result.lotSize = 0;
      }
      
      return result;
   }
   
   bool IsEquityLocked()
   {
      double equity = AccountInfoDouble(ACCOUNT_EQUITY);
      return (equity <= m_lockedEquity);
   }
   
   double GetLockedEquity() { return m_lockedEquity; }
   ENUM_GROWTH_PHASE GetCurrentPhase() { return m_currentPhase; }
   
private:
   void DeterminePhase(double equity)
   {
      if(equity < Phase1_Threshold)
         m_currentPhase = PHASE_SURVIVAL;
      else if(equity < Phase2_Threshold)
         m_currentPhase = PHASE_SCALING;
      else if(equity < Phase3_Threshold)
         m_currentPhase = PHASE_GROWTH;
      else
         m_currentPhase = PHASE_INSTITUTIONAL;
   }
   
   void CheckMilestone()
   {
      double target = m_initialEquity;
      while(target * EquityLockMultiplier <= m_peakEquity)
      {
         target = target * EquityLockMultiplier;
      }
      
      if(target > m_lockedEquity && m_peakEquity >= target)
      {
         m_lockedEquity = target;
         Print("========================================");
         Print("!!! MILESTONE ACHIEVED !!!");
         Print(StringFormat("Equity locked at: $%.2f", m_lockedEquity));
         Print("========================================");
      }
   }
};

