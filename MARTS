//| CLASS 2: MARKET REGIME DETECTOR                                  |
//+------------------------------------------------------------------+
class CRegimeDetector
{
public:
   struct SRegimeInfo
   {
      ENUM_MARKET_REGIME regime;
      double volatility;
      double trendStrength;
      double adx;
      bool canTrade;
      double riskMultiplier;
      string description;
   };
   
   SRegimeInfo Detect()
   {
      SRegimeInfo result;
      
      double atr = iATR(_Symbol, PERIOD_H1, 14, 0);
      double price = iClose(_Symbol, PERIOD_H1, 0);
      result.volatility = (atr / price) * 100;
      
      double fastMA = iMA(_Symbol, PERIOD_H1, FastMAPeriod, 0, MODE_EMA, PRICE_CLOSE, 0);
      double slowMA = iMA(_Symbol, PERIOD_H1, SlowMAPeriod, 0, MODE_EMA, PRICE_CLOSE, 0);
      result.adx = iADX(_Symbol, PERIOD_H1, 14, PRICE_CLOSE, MODE_MAIN, 0);
      result.trendStrength = MathAbs(fastMA - slowMA) / atr;
      
      // Determine regime
      if(result.adx > 25 && result.trendStrength > 0.5)
      {
         result.regime = (fastMA > slowMA) ? REGIME_TRENDING_BULL : REGIME_TRENDING_BEAR;
         result.canTrade = true;
         result.riskMultiplier = 1.0;
         result.description = (fastMA > slowMA) ? "BULL TREND" : "BEAR TREND";
      }
      else if(result.adx < 20)
      {
         result.regime = REGIME_RANGING;
         result.canTrade = false;
         result.riskMultiplier = 0;
         result.description = "RANGING - NO TRADE";
      }
      else if(result.volatility > 1.5)
      {
         result.regime = REGIME_VOLATILE;
         result.canTrade = true;
         result.riskMultiplier = 0.5;
         result.description = "VOLATILE - REDUCE RISK";
      }
      else
      {
         result.regime = REGIME_LOW_VOLATILITY;
         result.canTrade = true;
         result.riskMultiplier = 0.8;
         result.description = "LOW VOLATILITY - SAFE";
      }
      
      return result;
   }
};

//+------------------------------------------------------------------+
//| CLASS 3: SMC ENGINE - BOS/CHoCH + Liquidity Sweeps               |
//+------------------------------------------------------------------+
class CSMCEngine
{
private:
   string m_symbol;
   double m_lastHigh;
   double m_lastLow;
   bool m_isBullishStructure;
   int m_bosCount;
   int m_chochCount;
   
public:
   CSMCEngine(string symbol)
   {
      m_symbol = symbol;
      m_isBullishStructure = true;
      m_bosCount = 0;
      m_chochCount = 0;
      m_lastHigh = iHigh(m_symbol, PERIOD_H1, 1);
      m_lastLow = iLow(m_symbol, PERIOD_H1, 1);
   }
   
   struct SMarketStructure
   {
      ENUM_MARKET_STRUCTURE current;
      bool isReversal;
      double trendStrength;
      string description;
   };
   
   SMarketStructure AnalyzeStructure(bool reversalOnly)
   {
      SMarketStructure result;
      result.current = STRUCT_STABLE;
      result.isReversal = false;
      result.trendStrength = 0;
      result.description = "";
      
      double currentHigh = iHigh(m_symbol, PERIOD_M15, 0);
      double currentLow = iLow(m_symbol, PERIOD_M15, 0);
      double close = iClose(m_symbol, PERIOD_M15, 0);
      double prevHigh = iHigh(m_symbol, PERIOD_M15, 1);
      double prevLow = iLow(m_symbol, PERIOD_M15, 1);
      
      // CHoCH Detection (Reversal) - HIGHEST PRIORITY
      if(m_isBullishStructure && currentLow < m_lastLow && close > prevLow)
      {
         result.current = STRUCT_CHOCH_BEARISH;
         result.isReversal = true;
         result.description = "Bearish CHoCH - Reversal Confirmed";
         m_isBullishStructure = false;
         m_lastLow = currentLow;
         m_chochCount++;
         Print("MARTS_AI: BEARISH CHOCH DETECTED");
      }
      else if(!m_isBullishStructure && currentHigh > m_lastHigh && close < prevHigh)
      {
         result.current = STRUCT_CHOCH_BULLISH;
         result.isReversal = true;
         result.description = "Bullish CHoCH - Reversal Confirmed";
         m_isBullishStructure = true;
         m_lastHigh = currentHigh;
         m_chochCount++;
         Print("MARTS_AI: BULLISH CHOCH DETECTED");
      }
      
      // BOS Detection (Continuation) - Only if reversal-only is OFF
      else if(!reversalOnly && m_isBullishStructure && currentHigh > m_lastHigh)
      {
         result.current = STRUCT_BOS_BULLISH;
         result.description = "Bullish BOS - Trend Continuation";
         m_lastHigh = currentHigh;
         m_bosCount++;
      }
      else if(!reversalOnly && !m_isBullishStructure && currentLow < m_lastLow)
      {
         result.current = STRUCT_BOS_BEARISH;
         result.description = "Bearish BOS - Trend Continuation";
         m_lastLow = currentLow;
         m_bosCount++;
      }
      
      // Liquidity Sweep Detection
      else if(DetectLiquiditySweep())
      {
         result.current = STRUCT_LIQUIDITY_SWEEP;
         result.isReversal = true;
         result.description = "Liquidity Sweep - Smart Money Entry";
      }
      
      // Calculate trend strength
      result.trendStrength = (double)(m_bosCount + 1) / (m_chochCount + 1);
      result.trendStrength = MathMin(result.trendStrength, 3.0) / 3.0;
      
      return result;
   }
   
   SLiquiditySweep DetectLiquiditySweep()
   {
      SLiquiditySweep result;
      result.isValid = false;
      result.confidence = 0;
      
      double currentHigh = iHigh(m_symbol, PERIOD_M15, 0);
      double currentLow = iLow(m_symbol, PERIOD_M15, 0);
      double prevHigh = iHigh(m_symbol, PERIOD_M15, 1);
      double prevLow = iLow(m_symbol, PERIOD_M15, 1);
      double close = iClose(m_symbol, PERIOD_M15, 0);
      
      // Bullish sweep: Price broke previous low but closed above
      if(currentLow < prevLow && close > prevLow)
      {
         result.isValid = true;
         result.sweepPrice = currentLow;
         result.sweepTime = TimeCurrent();
         result.direction = POSITION_TYPE_BUY;
         result.targetPrice = prevHigh + (prevHigh - prevLow);
         result.confidence = 0.85;
      }
      // Bearish sweep: Price broke previous high but closed below
      else if(currentHigh > prevHigh && close < prevHigh)
      {
         result.isValid = true;
         result.sweepPrice = currentHigh;
         result.sweepTime = TimeCurrent();
         result.direction = POSITION_TYPE_SELL;
         result.targetPrice = prevLow - (prevHigh - prevLow);
         result.confidence = 0.85;
      }
      
      return result;
   }
   
   ENUM_POSITION_TYPE GetDirectionFromStructure(SMarketStructure &structure)
   {
      switch(structure.current)
      {
         case STRUCT_BOS_BULLISH:
         case STRUCT_CHOCH_BULLISH:
            return POSITION_TYPE_BUY;
         case STRUCT_BOS_BEARISH:
         case STRUCT_CHOCH_BEARISH:
            return POSITION_TYPE_SELL;
         default:
            return WRONG_VALUE;
      }
   }
};

//+------------------------------------------------------------------+
//| CLASS 4: CRT ENGINE - Asia Range + London/NY Sessions            |
//+------------------------------------------------------------------+
class CCRTEngine
{
private:
   string m_symbol;
   double m_asiaHigh;
   double m_asiaLow;
   datetime m_asiaStart;
   bool m_asiaIdentified;
   
public:
   CCRTEngine(string symbol)
   {
      m_symbol = symbol;
      m_asiaIdentified = false;
      m_asiaHigh = 0;
      m_asiaLow = 0;
   }
   
   struct SCRTSetup
   {
      ENUM_CRT_PATTERN pattern;
      double entryPrice;
      double stopLoss;
      double takeProfit;
      double confidence;
      bool isValid;
      string description;
   };
   
   void UpdateAsiaRange()
   {
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      
      datetime todayStart = StringToTime(StringFormat("%04d.%02d.%02d 00:00:00", dt.year, dt.month, dt.day));
      datetime asiaEnd = todayStart + 8 * 3600;
      
      if(TimeCurrent() >= asiaEnd && !m_asiaIdentified)
      {
         m_asiaStart = todayStart;
         m_asiaHigh = iHigh(m_symbol, PERIOD_H1, iBarShift(m_symbol, PERIOD_H1, asiaEnd));
         m_asiaLow = iLow(m_symbol, PERIOD_H1, iBarShift(m_symbol, PERIOD_H1, asiaEnd));
         m_asiaIdentified = true;
         
         Print("Asia Range: High=", m_asiaHigh, " Low=", m_asiaLow);
         DrawAsiaRange();
      }
   }
   
   SCRTSetup Analyze()
   {
      SCRTSetup result;
      result.isValid = false;
      result.confidence = 0;
      
      if(!m_asiaIdentified) return result;
      
      double currentPrice = SymbolInfoDouble(m_symbol, SYMBOL_BID);
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      
      bool isLondon = (dt.hour >= LondonStart && dt.hour < LondonEnd);
      bool isNY = (dt.hour >= NYStart && dt.hour < NYEnd);
      double range = m_asiaHigh - m_asiaLow;
      
      if(isLondon && currentPrice > m_asiaHigh)
      {
         result.pattern = CRT_LONDON_BREAKOUT;
         result.entryPrice = currentPrice;
         result.stopLoss = m_asiaLow - (range * 0.3);
         result.takeProfit = currentPrice + (range * 1.5);
         result.confidence = 0.75;
         result.isValid = true;
         result.description = "London Breakout Above Asia High";
      }
      else if(isLondon && currentPrice < m_asiaLow)
      {
         result.pattern = CRT_LONDON_BREAKOUT;
         result.entryPrice = currentPrice;
         result.stopLoss = m_asiaHigh + (range * 0.3);
         result.takeProfit = currentPrice - (range * 1.5);
         result.confidence = 0.75;
         result.isValid = true;
         result.description = "London Breakdown Below Asia Low";
      }
      else if(isNY && currentPrice < m_asiaHigh && currentPrice > m_asiaLow)
      {
         result.pattern = CRT_NY_REVERSAL;
         result.entryPrice = currentPrice;
         result.confidence = 0.65;
         result.isValid = true;
         result.description = "NY Reversal Setup";
      }
      
      return result;
   }
   
   void DrawAsiaRange()
   {
      string name = "Asia_Range_" + TimeToString(m_asiaStart);
      if(ObjectFind(0, name) >= 0) ObjectDelete(0, name);
      
      datetime asiaEnd = m_asiaStart + 8 * 3600;
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, m_asiaStart, m_asiaHigh, asiaEnd, m_asiaLow);
      ObjectSetInteger(0, name, OBJPROP_FILL, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
      ObjectSetInteger(0, name, OBJPROP_COLOR, clrGoldenrod);
   }
};

