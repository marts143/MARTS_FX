//| CLASS 6: RISK MANAGER - Prop Firm Ready                          |
//+------------------------------------------------------------------+
class CRiskManager
{
private:
   double m_startBalance;
   double m_dailyStartEquity;
   double m_weeklyStartEquity;
   double m_maxDailyLoss;
   double m_maxDrawdown;
   double m_dailyTarget;
   double m_weeklyTarget;
   datetime m_lastDailyReset;
   datetime m_lastWeeklyReset;
   int m_tradesToday;
   
public:
   CRiskManager()
   {
      m_startBalance = AccountInfoDouble(ACCOUNT_BALANCE);
      m_dailyStartEquity = AccountInfoDouble(ACCOUNT_EQUITY);
      m_weeklyStartEquity = m_dailyStartEquity;
      m_maxDailyLoss = m_startBalance * (MaxDailyLoss / 100.0);
      m_maxDrawdown = m_startBalance * (MaxTotalDrawdown / 100.0);
      m_dailyTarget = m_startBalance * (DailyProfitTarget / 100.0);
      m_weeklyTarget = m_startBalance * (WeeklyProfitTarget / 100.0);
      m_lastDailyReset = TimeCurrent();
      m_lastWeeklyReset = TimeCurrent();
      m_tradesToday = 0;
   }
   
   void Update()
   {
      datetime now = TimeCurrent();
      MqlDateTime dt;
      TimeToStruct(now, dt);
      
      if(now - m_lastDailyReset >= 86400)
      {
         m_dailyStartEquity = AccountInfoDouble(ACCOUNT_EQUITY);
         m_maxDailyLoss = m_dailyStartEquity * (MaxDailyLoss / 100.0);
         m_dailyTarget = m_dailyStartEquity * (DailyProfitTarget / 100.0);
         m_lastDailyReset = now;
         m_tradesToday = 0;
         Print("Daily reset - New equity: $", m_dailyStartEquity);
      }
      
      if(dt.day_of_week == 1 && now - m_lastWeeklyReset >= 86400)
      {
         m_weeklyStartEquity = AccountInfoDouble(ACCOUNT_EQUITY);
         m_weeklyTarget = m_weeklyStartEquity * (WeeklyProfitTarget / 100.0);
         m_lastWeeklyReset = now;
         Print("Weekly reset - New equity: $", m_weeklyStartEquity);
      }
   }
   
   struct SRiskCheck
   {
      bool canTrade;
      string reason;
      double allowedLot;
   };
   
   SRiskCheck CanTrade(double stopLossPoints, double riskPercent)
   {
      SRiskCheck result;
      result.canTrade = true;
      result.reason = "";
      
      double currentEquity = AccountInfoDouble(ACCOUNT_EQUITY);
      double dailyLoss = m_dailyStartEquity - currentEquity;
      double totalLoss = m_startBalance - currentEquity;
      double dailyProfit = currentEquity - m_dailyStartEquity;
      double weeklyProfit = currentEquity - m_weeklyStartEquity;
      
      if(dailyLoss >= m_maxDailyLoss)
      {
         result.canTrade = false;
         result.reason = StringFormat("Daily loss limit: $%.2f", dailyLoss);
         return result;
      }
      
      if(totalLoss >= m_maxDrawdown)
      {
         result.canTrade = false;
         result.reason = StringFormat("Max drawdown: $%.2f", totalLoss);
         return result;
      }
      
      if(CloseOnTarget && dailyProfit >= m_dailyTarget)
      {
         result.canTrade = false;
         result.reason = "Daily target reached";
         return result;
      }
      
      if(CloseOnTarget && weeklyProfit >= m_weeklyTarget)
      {
         result.canTrade = false;
         result.reason = "Weekly target reached";
         return result;
      }
      
      if(m_tradesToday >= 5)
      {
         result.canTrade = false;
         result.reason = "Max trades per day";
         return result;
      }
      
      result.allowedLot = CalculateLotSize(stopLossPoints, riskPercent);
      return result;
   }
   
   void RecordTrade() { m_tradesToday++; }
   
private:
   double CalculateLotSize(double stopLossPoints, double riskPercent)
   {
      if(stopLossPoints <= 0) return 0;
      
      double riskAmount = AccountInfoDouble(ACCOUNT_BALANCE) * (riskPercent / 100.0);
      double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
      double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      
      double lotSize = riskAmount / (stopLossPoints * tickValue);
      lotSize = MathFloor(lotSize / lotStep) * lotStep;
      lotSize = MathMax(lotSize, minLot);
      
      return lotSize;
   }
};

